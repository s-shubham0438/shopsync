# Copy to .env and adjust. Never commit .env.

# --- Application -------------------------------------------------------------
APP_NAME=ShopSync API
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true = one JSON object per line (production); false = human-readable (dev)
LOG_JSON=false
# Serve Swagger UI (/docs), ReDoc (/redoc) and the OpenAPI schema
DOCS_ENABLED=true

# --- HTTP / CORS -------------------------------------------------------------
# Comma-separated list (or JSON array) of frontend origins. "*" is rejected
# because auth uses cookies (credentials), which browsers forbid with "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL --------------------------------------------------------------
# postgresql:// is accepted and automatically upgraded to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://shopsync:shopsync@localhost:5432/shopsync
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_ECHO=false

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Caching -----------------------------------------------------------------
CACHE_TTL_SECONDS=1800

# --- Health ------------------------------------------------------------------
HEALTH_CHECK_TIMEOUT_SECONDS=2
