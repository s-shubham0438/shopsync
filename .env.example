# Copy to .env and adjust.
APP_NAME="ShopSync API"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
DOCS_ENABLED=true

# Comma-separated or JSON list. No wildcard (auth cookies need explicit origins).
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://shopsync:shopsync@localhost:5432/shopsync
# Local Memurai/Redis with a password: redis://:<password>@localhost:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
# --- Authentication ---
# Required in production (>= 32 random characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset outside production = random key per process (everyone is logged out on restart).
AUTH_SECRET_KEY=change-me-to-a-long-random-string-in-every-environment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookies are HttpOnly + Secure + SameSite. Serve the API same-origin (proxy /api) or same-site.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=shopsync.in
# Reverse proxies in front of the API whose X-Forwarded-For is trusted (0 = none).
TRUSTED_PROXY_COUNT=0
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_PER_IP=50
AUTH_RATE_LIMIT_PER_ACCOUNT=10
AUTH_SIGNUP_LIMIT_PER_HOUR=10
AUTH_REFRESH_LIMIT_PER_IP=60
# Max signed-in devices per user; a new login beyond this ends the oldest session.
AUTH_MAX_SESSIONS=10
# Seconds a just-rotated refresh token is treated as a two-tab race rather than theft.
REFRESH_REUSE_GRACE_SECONDS=10

# Cache (fail-open: if Redis is down, search still works uncached)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1800
CACHE_PARTIAL_TTL_SECONDS=60
CACHE_OP_TIMEOUT_SECONDS=0.25
CACHE_FAILURE_BACKOFF_SECONDS=30
CACHE_MAX_ENTRY_BYTES=1000000
HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- Store adapters -----------------------------------------------------------
# Stores searched per query (comma-separated slugs: amazon, flipkart, myntra, ajio, croma, tatacliq).
ENABLED_STORES=amazon,flipkart,myntra,ajio,croma,tatacliq
# mock = demo data from the seed catalogue; live = official/affiliate APIs (none implemented yet).
STORE_ADAPTER_MODE=mock
# Per-store time limit (seconds, max 30) and optional overrides, e.g. amazon=6,croma=3
STORE_ADAPTER_TIMEOUT_SECONDS=4
STORE_ADAPTER_TIMEOUTS=
# Mock only: simulated latency, and the fraction of calls that fail (must be 0 in production).
MOCK_ADAPTER_LATENCY_MS=150
MOCK_ADAPTER_FAILURE_RATE=0
